{
  "name": "joint-liability",
  "version": "0.1.0",
  "private": true,
  "description": "Joint Liability browser game foundation",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "check": "npm run content:types:check && tsc --noEmit",
    "test:engine": "vitest run tests/unit",
    "test:content": "vitest run tests/content/content-validation.test.ts",
    "content:types": "node tools/generate-types.mjs",
    "content:types:check": "node tools/generate-types.mjs --check",
    "content:validate": "node tools/validate-content/index.mjs",
    "content:report": "node tools/content-report/index.mjs",
    "test:replay": "vitest run tests/replay/determinism.test.ts",
    "test:browser": "playwright test",
    "test:properties": "vitest run tests/properties",
    "test:m03": "vitest run tests/unit/deck-turn.test.ts tests/properties/deck-turn.property.test.ts",
    "test:m04": "vitest run tests/unit/hp-damage-targeting.test.ts tests/properties/hp-damage-targeting.property.test.ts",
    "test:m05": "vitest run tests/unit/enemy-intents.test.ts",
    "test:m06": "vitest run tests/unit/status-timing.test.ts tests/properties/status-damage.property.test.ts",
    "test:m07": "vitest run tests/unit/imprint-reactions.test.ts tests/properties/imprint-swap.property.test.ts",
    "test:m08": "vitest run tests/unit/remaining-reactions-delayed.test.ts",
    "test:m09": "vitest run tests/unit/trigger-passives.test.ts",
    "test:m10": "vitest run tests/unit/m10-fight.test.ts",
    "test:m11": "vitest run tests/unit/card-lifecycle.test.ts",
    "test:m12": "vitest run tests/unit/source-card-pool.test.ts",
    "test:m13": "vitest run tests/unit/shaper-crew-junk-pool.test.ts",
    "test:m14": "vitest run tests/unit/first-relics.test.ts",
    "test:m15": "vitest run tests/unit/remaining-relics.test.ts",
    "test:m16": "vitest run tests/unit/family-transformations.test.ts",
    "test:m17": "vitest run tests/unit/initial-enemies.test.ts",
    "test:m18": "vitest run tests/unit/rewards.test.ts",
    "simulate": "node tools/not-implemented.mjs M33 \"simulation\"",
    "assets:audit": "node tools/not-implemented.mjs M35 \"asset audit\"",
    "build": "vite build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "pixi.js": "8.20.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "4.9.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
